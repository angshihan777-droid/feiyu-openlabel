# CE (Community Edition) 环境变量
# 推荐: start-ce.bash --demo 或 start-ce.ps1 -Demo(自动创建本文件并生成密钥)

# 数据卷挂载(宿主机路径)
FY_USER_DATA_ROOT=~/tmp/feiyu_ce_user_data
FY_MEDIA_HOST_DIR=~/tmp/feiyu_ce_media
LOG_ROOT=~/tmp/feiyu_ce_logs
REDIS_DATA_DIR=~/tmp/feiyu_ce_redis_data
POSTGRES_DATA_DIR=~/tmp/feiyu_ce_postgres_data

# 端口映射(宿主 -> 容器)
WEB_APP_PORT=6600
WEB_API_PORT=6610

# 镜像源：默认使用南京大学 GHCR 镜像站，国内网络更稳定。
# 如需 GitHub 官方源，把 ghcr.nju.edu.cn 改为 ghcr.io。
FY_FRONTEND_IMAGE=ghcr.nju.edu.cn/angshihan777-droid/feiyu-frontend-ce:snapshot-ce
FY_BACKEND_IMAGE=ghcr.nju.edu.cn/angshihan777-droid/feiyu-backend-ce:snapshot-ce
FY_POSTGRES_IMAGE=ghcr.nju.edu.cn/ferretdb/postgres-documentdb:17-0.105.0-ferretdb-2.4.0
FY_FERRETDB_IMAGE=ghcr.nju.edu.cn/ferretdb/ferretdb:2.4.0

# 后端运行期敏感配置(Settings 通过 env_prefix='FY_' 读取)
# start-ce 脚本会在首次启动时自动生成并写入 64 位十六进制随机密钥
FY_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# 本地演示页快捷身份按钮。共享/生产环境必须保持 false。
FY_DEMO_QUICK_LOGIN=false
FY_DEMO_ACCOUNT_DOMAIN=example.com
